<Window x:Class="LunchBox.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LunchBox 検索" Height="520" Width="860" MinHeight="300" MinWidth="520"
        WindowStyle="ToolWindow" ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        FontSize="13" Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <TextBox x:Name="FilterBox" Height="32" FontSize="15" VerticalContentAlignment="Center" Padding="6,0"
                     TextChanged="FilterBox_TextChanged" PreviewKeyDown="FilterBox_PreviewKeyDown"/>
            <TextBlock x:Name="Placeholder" Text="ファイル名・フォルダ名・URL・アプリ名・クリップボードの文字で絞り込み（空白区切りで AND）" Foreground="Gray"
                       VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
        </Grid>
        <ListView x:Name="List" Grid.Row="1"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="34">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding AppIcon}" Width="20" Height="20" ToolTip="{Binding AppName}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Width="30">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding ItemIcon}" Width="18" Height="18"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="名前" Width="300" DisplayMemberBinding="{Binding Title}"/>
                    <GridViewColumn Header="場所" Width="240" DisplayMemberBinding="{Binding Sub}"/>
                    <GridViewColumn Header="日時" Width="110" DisplayMemberBinding="{Binding WhenText}"/>
                    <GridViewColumn Header="種類" Width="70" DisplayMemberBinding="{Binding KindText}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <DockPanel Grid.Row="2" Margin="0,6,0,0">
            <TextBlock x:Name="CountText" Foreground="Gray" VerticalAlignment="Center"/>
            <TextBlock Text="　↑↓で選択、Enter で開く（クリップはクリップボードへ戻す）、Esc で閉じる。" Foreground="Gray" VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
