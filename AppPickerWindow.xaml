<Window x:Class="LunchBox.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="アプリ一覧から追加" Height="520" Width="560"
        WindowStartupLocation="CenterOwner" FontSize="13" ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="絞り込み" VerticalAlignment="Center"/>
            <TextBox x:Name="FilterBox" Width="300" Height="26" Margin="8,0,0,0" VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged"/>
            <TextBlock x:Name="CountText" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>
        <ListBox x:Name="AppList" Grid.Row="1" MouseDoubleClick="AppList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Kind}" Foreground="Gray" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Grid.Row="2" Foreground="Gray" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Windows の「すべてのアプリ」に出るものを選べます。ペイント・電卓・メモ帳などのストアアプリも登録できます（ストアアプリは「管理者として実行」はできません）。"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="追加" Width="90" Height="28" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="キャンセル" Width="90" Height="28" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
