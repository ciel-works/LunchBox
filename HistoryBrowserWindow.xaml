<Window x:Class="LunchBox.HistoryBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="履歴" Height="620" Width="820" MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterScreen" FontSize="13" ShowInTaskbar="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="絞り込み" VerticalAlignment="Center"/>
            <TextBox x:Name="FilterBox" Width="360" Height="26" Margin="8,0,0,0" VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged"/>
            <TextBlock x:Name="CountText" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <TextBlock Text="（ダブルクリック／Enter で実行、右クリックで操作）" Foreground="Gray" VerticalAlignment="Center" Margin="14,0,0,0"/>
        </StackPanel>
        <ListView x:Name="List" Grid.Row="1"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.IsDeferredScrollingEnabled="False"
                  MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown"
                  ContextMenuOpening="List_ContextMenuOpening">
            <ListView.ContextMenu>
                <ContextMenu x:Name="RowMenu"/>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="34">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Icon}" Width="20" Height="20"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="内容" Width="420" DisplayMemberBinding="{Binding Title}"/>
                    <GridViewColumn Header="補足" Width="200" DisplayMemberBinding="{Binding Sub}"/>
                    <GridViewColumn Header="日時" Width="130" DisplayMemberBinding="{Binding WhenText}"/>
                </GridView>
            </ListView.View>
        </ListView>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="PrimaryButton" Content="開く" Width="120" Height="28" Margin="0,0,8,0" Click="Primary_Click"/>
            <Button Content="閉じる" Width="90" Height="28" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
